# Sneaky Peek API — example configuration.
# Copy to server/.env for local development. Never commit a real .env file.
# Values below are placeholders, not working credentials.

# --- Core (required) ---
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/sneakypeek
# At least 32 random characters in production. Example: `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string
# Public URL of the web app. Used for payment redirects and the CORS allow-list.
APP_URL=http://localhost:5173
# Optional extra allowed browser origins, comma separated.
CORS_ORIGINS=
# Set to 1 (or a proxy count) when running behind a load balancer / reverse proxy
# so rate limits and analytics see the real client IP.
TRUST_PROXY=

# --- AI (Anthropic) ---
# anthropic | mock   (mock is offline and deterministic; refused in production
# unless ALLOW_MOCK_AI=true)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=90000
ALLOW_MOCK_AI=

# --- Billing (Flutterwave) ---
# flutterwave | mock   (mock grants paid plans without payment; refused in
# production unless ALLOW_MOCK_BILLING=true — do not set that in production)
BILLING_PROVIDER=flutterwave
# Flutterwave dashboard > Settings > API keys (use TEST keys outside production)
FLW_SECRET_KEY=
# The "Secret hash" you set under Settings > Webhooks; sent as the verif-hash header
FLW_SECRET_HASH=
# Optional override, defaults to https://api.flutterwave.com/v3
FLW_BASE_URL=
ALLOW_MOCK_BILLING=
# Shared secret for the mock provider's simulated webhook (development only)
MOCK_WEBHOOK_SECRET=
# Days a failed renewal keeps paid access before dropping to Free
BILLING_GRACE_DAYS=3
# How often to reconcile subscriptions with Flutterwave (0 disables)
BILLING_RECONCILE_INTERVAL_MINUTES=60

# --- File storage ---
# Must be a persistent directory in production (see docs/DEPLOYMENT.md)
STORAGE_DIR=./uploads
MAX_DELIVERABLE_MB=25
